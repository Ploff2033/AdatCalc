POSTGRES_DB=calc
POSTGRES_USER=calc
POSTGRES_PASSWORD=change-me

# Уведомления в Telegram о новых заказах — опционально, если не заданы,
# отправка просто молча пропускается. Токен от @BotFather, chat_id — куда слать.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ссылка на VPN-подписку (VLESS) для сервиса xray — из неё раз в 6 часов
# собирается пул серверов прокси до api.telegram.org, при сбое отправки
# приложение само переключается на живой сервер. Секрет: только в .env на
# сервере. Пусто — пула нет, работает поле «Прокси» в Настройках.
XRAY_SUBSCRIPTION_URL=
